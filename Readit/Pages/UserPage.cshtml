
@page "{id?}"
@inject Microsoft.Extensions.Localization.IStringLocalizer<Readit.Pages.UserPageLocalizer> Localizer
@model Readit.Pages.UserPage

@{
    ViewData["Title"] = "User Profile";
}

@using System.ComponentModel.DataAnnotations
@using System.Reflection

@functions {
    string GetDisplayName(Enum value)
    {
        return value.GetType()
            .GetMember(value.ToString())
            .First()
            .GetCustomAttribute<DisplayAttribute>()?
            .GetName() ?? value.ToString();
    }
}

<div class="container my-4">
    <div class="row mb-4 d-flex align-items-start" style="min-height: 140px;">
    <div class="col-auto">
            <div class="text-center">
                <img src="/avatars/@Model.CurrentUser.AvatarFileName?ts=@DateTime.Now.Ticks"
                     class="rounded-circle border"
                     style="width: 140px; height: 140px; object-fit: cover;"
                     alt="Avatar" />
                @if (Model.IsSelf)
                {
                    <form method="post"
                          enctype="multipart/form-data"
                          asp-page-handler="UploadAvatar"
                          id="avatarForm"
                          class="mt-2">

                        <input type="file"
                               id="avatarInput"
                               name="AvatarUpload"
                               style="display:none;"
                               onchange="document.getElementById('avatarForm').submit();" />

                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                onclick="document.getElementById('avatarInput').click();">
                            @Localizer["Change Avatar"]
                        </button>
                    </form>
                }


            </div>
           

        </div>
        <div class="col d-flex flex-column justify-content-center h-100">
            <h2>@Model.CurrentUser.FirstName @Model.CurrentUser.LastName</h2>

            <p class="profile-stats">
                <a asp-page="/FollowersList" asp-route-id="@Model.CurrentUser.Id" class="me-3">
                    <strong>@Model.FollowingCount</strong> @Localizer["following"]
                </a>
                <a asp-page="/FollowersList" asp-route-id="@Model.CurrentUser.Id" class="me-3">
                    <strong>@Model.FollowersCount</strong> @Localizer["followers"]
                </a>
                <strong>@Model.Books.Count</strong> @Localizer["books"]
            </p>

            @if (!Model.IsSelf && User.Identity?.IsAuthenticated == true)
            {
                @if (Model.IsFollowing)
                {
                    <form method="post"         
                          asp-page-handler="Unfollow"
                          asp-route-id="@Model.CurrentUser.Id"
                          class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger">
                            @Localizer["Unfollow"]
                        </button>
                    </form>
                }
                else
                {
                    <form method="post"
                          asp-page-handler="Follow"
                          asp-route-id="@Model.CurrentUser.Id"
                          class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success">
                            @Localizer["Follow"]
                        </button>
                    </form>
                }
            }

        </div>
       

    </div>

    <h3>@Localizer["Library"]</h3>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var book in Model.Books)
        {

            <div class="col">
            <div class="card h-100 d-flex flex-column" style="height: 100%;">
            <div style="cursor:pointer;" onclick="location.href='@Url.Page("/BookDetails", new { workKey = book.WorkKey.Split('/').Last() })'">
                <div class="d-flex align-items-center justify-content-center bg-light"
                     style="height: 300px; overflow: hidden;">
                    @if (book.CoverId.HasValue && book.CoverId > 0)
                    {
                        <img src="https://covers.openlibrary.org/b/id/@(book.CoverId)-L.jpg"
                             class="img-fluid" style="max-height: 100%; max-width: 100%;"/>
                    }
                    else
                    {
                        <img src="~/images/NoCover.png"
                             class="img-fluid" style="max-height: 100%; max-width: 100%;" alt="No Cover"/>
                    }
                </div>

                <div class="card-body d-flex flex-column justify-content-between" style="min-height: 130px;">
                    <h5 class="card-title">@book.Title</h5>
                    <p class="card-text">@book.Authors</p>
                    @if (book.Rating.HasValue)
                    {
                        <div class="text-warning" style="font-size: 1.2rem;" title="@book.Rating.Value/5">
                            @{
                                for (int i = 1; i <= 5; i++)
                                {
                                    <text>@(i <= book.Rating ? "★" : "☆")</text>
                                }
                            }
                        </div>
                    }


                </div>
            </div>

            <div class="card-footer bg-white border-0 mt-auto">
            <button type="button"
                    class="btn btn-sm w-100 btn-danger"
                    onclick='event.stopPropagation(); toggleLibrary(this, {
                        title: "@book.Title",
                        authorName: @Html.Raw(Json.Serialize(book.Authors?.Split(", ").ToList() ?? new List<string>())),
                        coverId: @(book.CoverId ?? 0),
                        key: "@book.WorkKey"
                    })'>
            @Localizer["Remove"]
        </button>

            <select class="form-select mt-2" onchange="updateStatus(this.value, '@book.WorkKey')">
                @foreach (Readit.Models.ReadingStatus status in Enum.GetValues(typeof(Readit.Models.ReadingStatus)))
                {
                    <option value="@status" selected="@(book.Status == status)">
                        @GetDisplayName(status)
                    </option>
                }
            </select>
        </div>
    </div>
</div>

        }
    </div>
</div>

@section Scripts {
    <script>
        async function toggleLibrary(button, book) {
            const response = await fetch("/Search?handler=Toggle", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(book)
            });

            const result = await response.json();

            if (!result.added) {
                button.closest(".col").remove();
            }
        }
        async function updateStatus(status, key) {
            const response = await fetch('/UserPage?handler=UpdateStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ key, status })
            });

            const result = await response.json();
            if (!result.success) {
                alert("❌ Failed to update status.");
            }
        }
    </script>
}

@section Styles {
<style>
    .profile-stats a {
        color: inherit !important;
        text-decoration: none !important;
    }

    .profile-stats a:hover {
        color: #007bff !important;
    }
</style>
}

}

