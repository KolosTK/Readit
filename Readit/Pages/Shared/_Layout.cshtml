@inject Microsoft.Extensions.Localization.IStringLocalizer<Readit.Pages.Shared.LayoutLocalizer> Localizer




@using System.Globalization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Globalization

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Readit</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Readit.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index">Readit</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    
                    @if (User.IsInRole("admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/UserPage">@Localizer["Home"]</a>
                        </li><li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Search">@Localizer["Search"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Admin/ManageUsers">@Localizer["Manage Users"]</a>
                        </li>
                    }
                </ul>
                <partial name = "_LoginPartial"/>
                <ul class="navbar-nav">
                <li class="nav-item">
                    <form method="get" asp-page="/SetLanguage" class="d-inline">
                        <input type="hidden" name="culture" value="@(CultureInfo.CurrentCulture.Name == "uk" ? "en" : "uk")" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary d-flex align-items-center">
                            <i class="bi bi-translate me-1"></i>
                            @if (CultureInfo.CurrentCulture.Name == "uk")
                            {
                                <span>EN</span>
                            }
                            else
                            {
                                <span>UK</span>
                            }
                        </button>
                    </form>
                </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>