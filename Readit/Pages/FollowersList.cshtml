@page "{id?}"
@inject Microsoft.Extensions.Localization.IStringLocalizer<Readit.Pages.FollowersListLocalizer> Localizer
@model Readit.Pages.FollowersListModel
@{
    ViewData["Title"] = "Followers & Following";
}

<h2>@Localizer["UserNetworkHeading", Model.UserName]</h2>

<div class="list-group">
    @foreach (var user in Model.SortedUsers)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <img src="/avatars/@(user.AvatarFileName ?? "default-avatar.png")"
                     class="rounded-circle border"
                     style="width: 50px; height: 50px; object-fit: cover;" />

                <strong>@user.FirstName @user.LastName</strong>
            </div>

            @if (Model.CurrentUserId != user.Id)
            {
                <div class="d-flex gap-2 align-items-stretch" style="width: 320px;">
                    <div class="flex-fill">
                        @if (Model.FollowingIds.Contains(user.Id))
                        {
                            <form method="post" asp-page-handler="RemoveFriend" class="h-100">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-danger btn-sm w-100 h-100">
                                    @Localizer["Remove Friend"]
                                </button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="AddFriend" class="h-100">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-primary btn-sm w-100 h-100">
                                    @Localizer["Add Friend"]
                                </button>
                            </form>
                        }
                    </div>
                    <div class="flex-fill">
                        <a asp-page="/UserPage" asp-route-id="@user.Id" class="btn btn-outline-secondary w-100 h-100">
                            @Localizer["View Profile"]
                        </a>
                    </div>
                </div>

            }


        </div>
    }

</div>

@section Scripts {
    <script>
        function toggleOrder() {
            const url = new URL(window.location.href);
            const current = url.searchParams.get("order") || "following";
            url.searchParams.set("order", current === "following" ? "followers" : "following");
            window.location.href = url.toString();
        }
    </script>
}